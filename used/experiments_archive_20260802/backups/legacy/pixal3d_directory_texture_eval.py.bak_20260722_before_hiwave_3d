def progress_safe_print(
    *values: Any,
    sep: str = " ",
    end: str = "\n",
    file: Any = None,
    flush: bool = False,
) -> None:
    """Print without overwriting an active tqdm progress bar."""
    from tqdm import tqdm

    stream = file if file is not None else sys.stdout
    tqdm.write(sep.join(str(value) for value in values), file=stream, end=end)
    if flush:
        stream.flush()


def evaluation_tqdm(*args: Any, nested: bool = False, **kwargs: Any):
    """Create a terminal-friendly bar that stays out of redirected logs."""
    from tqdm import tqdm

    kwargs.setdefault("disable", None)
    kwargs.setdefault("dynamic_ncols", True)
    kwargs.setdefault("leave", not nested)
    return tqdm(*args, **kwargs)


