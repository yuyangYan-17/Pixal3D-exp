def json_safe(value: Any) -> Any:
    if isinstance(value, Path):
        return str(value)
    if isinstance(value, np.generic):
        return json_safe(value.item())
    if isinstance(value, np.ndarray):
        return value.tolist()
    if isinstance(value, torch.Tensor):
        return value.detach().cpu().tolist()
    if isinstance(value, float):
        return value if math.isfinite(value) else None
    if isinstance(value, Mapping):
        return {str(key): json_safe(item) for key, item in value.items()}
    if isinstance(value, (list, tuple)):
        return [json_safe(item) for item in value]
    return value


def atomic_json(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(path.suffix + ".tmp")
    with temporary.open("w", encoding="utf-8") as file:
        json.dump(json_safe(value), file, ensure_ascii=False, indent=2, allow_nan=False)
    temporary.replace(path)



# -----------------------------------------------------------------------------
# Embedded postprocess-cache implementation
# -----------------------------------------------------------------------------
# This cache captures the exact inputs passed to o_voxel.postprocess.to_glb().
# It is written before UV unwrapping/material baking, so a later postprocess-only
# script can replay the expensive export stage without rerunning Pixal3D.
POSTPROCESS_CACHE_VERSION = 1
POSTPROCESS_CACHE_TENSOR_KEYS = (
    "vertices",
    "faces",
    "attr_volume",
    "coords",
)
POSTPROCESS_CACHE_PYTHON_KEYS = (
    "attr_layout",
    "grid_size",
    "aabb",
    "decimation_target",
    "texture_size",
    "remesh",
    "use_tqdm",
    "verbose",
)


def _tensor_nbytes(tensor: torch.Tensor) -> int:
    return int(tensor.numel()) * int(tensor.element_size())


def _torch_save_fsynced(value: Any, path: Path) -> None:
    """Write one torch payload and fsync it before returning."""
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("wb") as file:
        torch.save(value, file)
        file.flush()
        os.fsync(file.fileno())


def inspect_to_glb_cache(
    cache_dir: Path,
) -> Tuple[bool, Optional[Dict[str, Any]], Optional[str]]:
    """Cheaply validate cache completeness without loading huge tensors."""
    cache_dir = Path(cache_dir)
    ready_path = cache_dir / "READY"
    manifest_path = cache_dir / "manifest.json"
    python_meta_path = cache_dir / "python_meta.pt"

    if not ready_path.is_file():
        return False, None, "READY marker is missing"
    if not manifest_path.is_file():
        return False, None, "manifest.json is missing"
    if not python_meta_path.is_file():
        return False, None, "python_meta.pt is missing"

    try:
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    except Exception as exc:
        return False, None, f"manifest.json cannot be read: {exc}"

    if int(manifest.get("cache_version", -1)) != POSTPROCESS_CACHE_VERSION:
        return (
            False,
            manifest,
            "unsupported cache version "
            f"{manifest.get('cache_version')!r}",
        )

    tensor_files = manifest.get("tensor_files")
    if not isinstance(tensor_files, Mapping):
        return False, manifest, "manifest tensor_files is invalid"

    for key in POSTPROCESS_CACHE_TENSOR_KEYS:
        record = tensor_files.get(key)
        if not isinstance(record, Mapping):
            return False, manifest, f"manifest entry for {key!r} is missing"
        filename = record.get("filename")
        if not filename:
            return False, manifest, f"filename for {key!r} is missing"
        tensor_path = cache_dir / str(filename)
        if not tensor_path.is_file():
            return False, manifest, f"{tensor_path.name} is missing"
        expected_size = int(record.get("serialized_size_bytes", 0) or 0)
        actual_size = int(tensor_path.stat().st_size)
        if actual_size <= 0:
            return False, manifest, f"{tensor_path.name} is empty"
        if expected_size > 0 and actual_size != expected_size:
            return (
                False,
                manifest,
                f"{tensor_path.name} size mismatch: "
                f"expected={expected_size}, actual={actual_size}",
            )

    expected_python_size = int(
        manifest.get("python_meta", {}).get("serialized_size_bytes", 0) or 0
    )
    actual_python_size = int(python_meta_path.stat().st_size)
    if actual_python_size <= 0:
        return False, manifest, "python_meta.pt is empty"
    if expected_python_size > 0 and actual_python_size != expected_python_size:
        return (
            False,
            manifest,
            "python_meta.pt size mismatch: "
            f"expected={expected_python_size}, actual={actual_python_size}",
        )

    return True, manifest, None


def save_to_glb_cache(
    cache_dir: Path,
    export_kwargs: Mapping[str, Any],
    extra_metadata: Optional[Mapping[str, Any]] = None,
    overwrite: bool = False,
) -> Dict[str, Any]:
    """Persist the exact ``to_glb`` inputs in a self-contained cache.

    Large CUDA tensors are copied and saved one at a time. This avoids holding
    CPU copies of vertices, faces, attributes, and coordinates simultaneously.
    The READY marker is created last; therefore an interrupted write is never
    mistaken for a complete cache.
    """
    cache_dir = Path(cache_dir)
    cache_dir.parent.mkdir(parents=True, exist_ok=True)

    ready, existing_manifest, reason = inspect_to_glb_cache(cache_dir)
    if ready and not overwrite:
        print(f"[postprocess-cache] valid cache already exists: {cache_dir}")
        return dict(existing_manifest or {})

    missing = [
        key
        for key in POSTPROCESS_CACHE_TENSOR_KEYS
        if key not in export_kwargs
    ]
    if missing:
        raise KeyError(
            "Cannot create postprocess cache; missing tensor keys: "
            + ", ".join(missing)
        )

    for key in POSTPROCESS_CACHE_TENSOR_KEYS:
        if not isinstance(export_kwargs[key], torch.Tensor):
            raise TypeError(
                f"export_kwargs[{key!r}] must be torch.Tensor, "
                f"got {type(export_kwargs[key]).__name__}"
            )

    estimated_tensor_bytes = sum(
        _tensor_nbytes(export_kwargs[key])
        for key in POSTPROCESS_CACHE_TENSOR_KEYS
    )
    free_disk_bytes = int(shutil.disk_usage(cache_dir.parent).free)
    # Serialized files are close to raw tensor size. Keep a conservative 1 GiB
    # headroom for metadata/filesystem overhead and any temporary bookkeeping.
    required_disk_bytes = int(estimated_tensor_bytes * 1.02) + 1024**3
    if free_disk_bytes < required_disk_bytes:
        raise OSError(
            "Insufficient disk space for postprocess cache: "
            f"estimated_required={required_disk_bytes / 1024**3:.2f} GiB, "
            f"free={free_disk_bytes / 1024**3:.2f} GiB, "
            f"parent={cache_dir.parent}"
        )

    if cache_dir.exists() and not ready:
        print(
            f"[postprocess-cache] replacing incomplete cache ({reason}): "
            f"{cache_dir}"
        )

    temporary_dir = Path(
        tempfile.mkdtemp(
            prefix=f".{cache_dir.name}.writing_",
            dir=str(cache_dir.parent),
        )
    )
    backup_dir = cache_dir.parent / (
        f".{cache_dir.name}.backup_{os.getpid()}_{time.time_ns()}"
    )
    started = time.perf_counter()

    try:
        tensor_manifest: Dict[str, Dict[str, Any]] = {}
        for key in POSTPROCESS_CACHE_TENSOR_KEYS:
            source = export_kwargs[key]
            filename = f"{key}.pt"
            output_path = temporary_dir / filename
            raw_bytes = _tensor_nbytes(source)
            print(
                f"[postprocess-cache] saving {key}: "
                f"shape={tuple(source.shape)} dtype={source.dtype} "
                f"device={source.device} raw={raw_bytes / 1024**3:.3f} GiB"
            )

            # Copy exactly one tensor to CPU at a time. Preserve dtype and shape.
            cpu_tensor = source.detach().to(device="cpu", non_blocking=False)
            if not cpu_tensor.is_contiguous():
                cpu_tensor = cpu_tensor.contiguous()
            _torch_save_fsynced(cpu_tensor, output_path)
            serialized_size = int(output_path.stat().st_size)

            tensor_manifest[key] = {
                "filename": filename,
                "shape": [int(value) for value in source.shape],
                "dtype": str(source.dtype).replace("torch.", ""),
                "source_device": str(source.device),
                "numel": int(source.numel()),
                "element_size_bytes": int(source.element_size()),
                "raw_size_bytes": int(raw_bytes),
                "serialized_size_bytes": serialized_size,
            }
            del cpu_tensor
            gc.collect()

        python_export_kwargs = {
            key: export_kwargs[key]
            for key in POSTPROCESS_CACHE_PYTHON_KEYS
            if key in export_kwargs
        }
        python_payload = {
            "cache_version": POSTPROCESS_CACHE_VERSION,
            "export_kwargs": python_export_kwargs,
            "tensor_keys": list(POSTPROCESS_CACHE_TENSOR_KEYS),
            "extra_metadata": dict(extra_metadata or {}),
        }
        python_meta_path = temporary_dir / "python_meta.pt"
        _torch_save_fsynced(python_payload, python_meta_path)

        manifest: Dict[str, Any] = {
            "cache_version": POSTPROCESS_CACHE_VERSION,
            "created_unix": float(time.time()),
            "purpose": "exact inputs immediately before o_voxel.postprocess.to_glb",
            "tensor_files": tensor_manifest,
            "python_meta": {
                "filename": "python_meta.pt",
                "keys": sorted(python_export_kwargs.keys()),
                "serialized_size_bytes": int(python_meta_path.stat().st_size),
            },
            "extra_metadata": json_safe(dict(extra_metadata or {})),
            "estimated_raw_tensor_bytes": int(estimated_tensor_bytes),
        }
        atomic_json(temporary_dir / "manifest.json", manifest)

        ready_payload = {
            "cache_version": POSTPROCESS_CACHE_VERSION,
            "created_unix": manifest["created_unix"],
            "manifest": "manifest.json",
        }
        ready_tmp = temporary_dir / "READY.tmp"
        with ready_tmp.open("w", encoding="utf-8") as file:
            json.dump(ready_payload, file, ensure_ascii=False, indent=2)
            file.write("\n")
            file.flush()
            os.fsync(file.fileno())
        os.replace(ready_tmp, temporary_dir / "READY")

        # Publish only after every payload and the READY marker are complete.
        old_cache_moved = False
        if cache_dir.exists():
            os.replace(cache_dir, backup_dir)
            old_cache_moved = True
        try:
            os.replace(temporary_dir, cache_dir)
        except Exception:
            if old_cache_moved and not cache_dir.exists() and backup_dir.exists():
                os.replace(backup_dir, cache_dir)
            raise
        if old_cache_moved and backup_dir.exists():
            shutil.rmtree(backup_dir, ignore_errors=True)

        valid, published_manifest, validation_error = inspect_to_glb_cache(
            cache_dir
        )
        if not valid:
            raise RuntimeError(
                "Published postprocess cache failed validation: "
                f"{validation_error}"
            )
        elapsed = time.perf_counter() - started
        print(
            f"[postprocess-cache] ready={cache_dir} "
            f"raw_tensors={estimated_tensor_bytes / 1024**3:.3f} GiB "
            f"seconds={elapsed:.3f}"
        )
        return dict(published_manifest or manifest)

    finally:
        if temporary_dir.exists():
            shutil.rmtree(temporary_dir, ignore_errors=True)
        # A stale backup is harmless but expensive; remove it only when the
        # published cache is present. If publication failed, restoration above
        # keeps the previous cache available.
        if cache_dir.exists() and backup_dir.exists():
            shutil.rmtree(backup_dir, ignore_errors=True)


def write_csv(path: Path, rows: Sequence[Mapping[str, Any]]) -> None:
    rows = list(rows)
    path.parent.mkdir(parents=True, exist_ok=True)
    preferred = [
        "status",
        "image_name",
        "source_image",
        "image_output_dir",
        "pipeline_resolution",
        "pipeline_type",
        "seed",
        "light",
        "render_resolution",
        "metric_resolution",
        "psnr_db",
        "ssim",
        "lpips",
        "decoder_vertices",
        "decoder_faces",
        "grid_resolution",
        "pipeline_seconds",
        "material_bake_seconds",
        "temporary_asset_write_seconds",
        "original_png",
        "render_png",
        "comparison_png",
        "generation_json",
        "error",
    ]
    keys = {key for row in rows for key in row.keys()}
    fields = [key for key in preferred if key in keys]
    fields.extend(sorted(key for key in keys if key not in fields))
    temporary = path.with_suffix(path.suffix + ".tmp")
    with temporary.open("w", encoding="utf-8", newline="") as file:
        writer = csv.DictWriter(file, fieldnames=fields, extrasaction="ignore")
        writer.writeheader()
        writer.writerows(rows)
    temporary.replace(path)


def composite_on_black(image: Image.Image) -> Image.Image:
    rgba = image.convert("RGBA")
    background = Image.new("RGBA", rgba.size, (0, 0, 0, 255))
    background.alpha_composite(rgba)
    return background.convert("RGB")


def save_metric_reference(
    condition_image: Image.Image,
    output_path: Path,
    render_resolution: int,
) -> Image.Image:
    reference = composite_on_black(condition_image)
    target_size = (int(render_resolution), int(render_resolution))
    if reference.size != target_size:
        reference = reference.resize(target_size, Image.Resampling.LANCZOS)
    output_path.parent.mkdir(parents=True, exist_ok=True)
    reference.save(output_path)
    return reference


def sanitize_directory_name(value: str) -> str:
    value = value.strip()
    value = re.sub(r"[\\/:*?\"<>|\x00-\x1f]+", "_", value)
    value = re.sub(r"\s+", "_", value)
    return value or "image"


def path_is_within(path: Path, parent: Path) -> bool:
    try:
        path.resolve().relative_to(parent.resolve())
        return True
    except ValueError:
        return False


def discover_images(
    image_dir: Path,
    output_dir: Path,
    recursive: bool,
    extensions: Sequence[str],
) -> List[Dict[str, Any]]:
    normalized_extensions = {
        extension.lower() if extension.startswith(".") else f".{extension.lower()}"
        for extension in extensions
    }
    iterator = image_dir.rglob("*") if recursive else image_dir.glob("*")
    candidates = []
    for path in iterator:
        if not path.is_file() or path.suffix.lower() not in normalized_extensions:
            continue
        if path_is_within(path, output_dir):
            continue
        candidates.append(path.resolve())
    candidates.sort(key=lambda item: str(item.relative_to(image_dir)).lower())

    sanitized_stems = [
        sanitize_directory_name(path.stem) for path in candidates
    ]
    stem_counts = Counter(sanitized_stems)
    records: List[Dict[str, Any]] = []
    for path, sanitized_stem in zip(candidates, sanitized_stems):
        relative_path = path.relative_to(image_dir)
        output_name = sanitized_stem
        if stem_counts[sanitized_stem] > 1:
            digest = hashlib.sha1(
                str(relative_path).encode("utf-8")
            ).hexdigest()[:8]
            output_name = f"{output_name}__{digest}"
        records.append(
            {
                "path": path,
                "relative_path": relative_path,
                "output_name": output_name,
            }
        )
    return records


def save_black_composited_render(path: Path, expected_resolution: int) -> Image.Image:
    with Image.open(path) as image:
        rgb = composite_on_black(image)
    target_size = (int(expected_resolution), int(expected_resolution))
    if rgb.size != target_size:
        rgb = rgb.resize(target_size, Image.Resampling.LANCZOS)
    rgb.save(path)
    return rgb


def save_comparison(
    original: Image.Image,
    rendered: Image.Image,
    output_path: Path,
) -> None:
    original_rgb = original.convert("RGB")
    rendered_rgb = rendered.convert("RGB")
    if rendered_rgb.size != original_rgb.size:
        rendered_rgb = rendered_rgb.resize(
            original_rgb.size,
            Image.Resampling.LANCZOS,
        )
    width, height = original_rgb.size
    comparison = Image.new("RGB", (width * 2, height), (255, 255, 255))
    comparison.paste(original_rgb, (0, 0))
    comparison.paste(rendered_rgb, (width, 0))
    output_path.parent.mkdir(parents=True, exist_ok=True)
    comparison.save(output_path)


